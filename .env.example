# Admin Authentication
# Generate a secure secret key for JWT tokens
ADMIN_JWT_SECRET=your-secret-key-here

# Admin credentials (username and bcrypt hashed password)
# Default password hash is for "admin123" - CHANGE THIS IN PRODUCTION
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2a$10$xVq8VNFJZgkJ6U2qX.W8Ye5KOw7YB2C0gBP4d.W3.J1RvV5b0wC2W

# GitHub API Configuration
# Create a personal access token with 'repo' permissions
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_OWNER=ekosup
GITHUB_REPO=ekosup.github.io
GITHUB_BRANCH=main
