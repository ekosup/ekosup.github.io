---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import { isAuthenticated } from "@utils/auth";

// Redirect if already logged in
if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect("/admin");
}
---

<Layout title="Admin Login">
  <main class="mx-auto max-w-3xl px-4 pb-12">
    <section class="prose prose-lg mx-auto pt-12 pb-8">
      <h1 class="text-center">Admin Login</h1>
      <p class="text-center text-skin-base">
        Login to access the blog post administration panel
      </p>
    </section>

    <div class="mx-auto max-w-md">
      <form id="login-form" class="space-y-4">
        <div>
          <label for="username" class="block text-sm font-medium text-skin-base mb-1">
            Username
          </label>
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full rounded-md border border-skin-line bg-skin-fill px-4 py-2 text-skin-base focus:border-skin-accent focus:outline-none"
            placeholder="Enter username"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-skin-base mb-1">
            Password
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full rounded-md border border-skin-line bg-skin-fill px-4 py-2 text-skin-base focus:border-skin-accent focus:outline-none"
            placeholder="Enter password"
          />
        </div>

        <div id="error-message" class="hidden text-red-500 text-sm"></div>

        <button
          type="submit"
          class="w-full rounded-md bg-skin-accent px-4 py-2 text-skin-inverted hover:bg-skin-accent/90 focus:outline-none focus:ring-2 focus:ring-skin-accent focus:ring-offset-2"
        >
          Login
        </button>
      </form>
    </div>
  </main>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorDiv = document.getElementById("error-message") as HTMLDivElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorDiv.classList.add("hidden");

      const formData = new FormData(form);
      const username = formData.get("username") as string;
      const password = formData.get("password") as string;

      try {
        const response = await fetch("/api/admin/login", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ username, password }),
        });

        const data = await response.json();

        if (response.ok) {
          // Redirect to admin dashboard
          window.location.href = "/admin";
        } else {
          errorDiv.textContent = data.error || "Login failed";
          errorDiv.classList.remove("hidden");
        }
      } catch {
        errorDiv.textContent = "An error occurred. Please try again.";
        errorDiv.classList.remove("hidden");
      }
    });
  </script>
</Layout>
